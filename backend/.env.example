# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rover:rover@localhost:5432/lunar_rover

# ── Dataset paths ─────────────────────────────────────────────────────────────
# Download from ISRO PRADAN portal: https://pradan.issdc.gov.in/
JP2_PATH=data/SLDEM2015_512_60S_60N_000_360.JP2
CRATER_CSV=data/lunar_crater_database_robbins_2018.csv
HYDROGEN_DAT=data/hydrogenhd.dat
IRON_DAT=data/ironhd.dat
THORIUM_DAT=data/thoriumhd.dat

# ── Planning ──────────────────────────────────────────────────────────────────
PLANNING_MAX_ITER=50000
RRT_STEP_SIZE=5.0
RRT_MAX_ITER=30000
HAZARD_INFLATION_RADIUS=3

# ── Simulation ────────────────────────────────────────────────────────────────
ROVER_SPEED_MS=0.5
ENERGY_PER_METER=0.12

# ── LiDAR (RPLiDAR A3) ────────────────────────────────────────────────────────
LIDAR_MAX_RANGE_M=100.0
LIDAR_MIN_QUALITY=15
LIDAR_SCAN_FREQ_HZ=15.0

# ── ML ────────────────────────────────────────────────────────────────────────
MODEL_CHECKPOINT=checkpoints/unet_cost.pt
USE_HEURISTIC_COST=true

# ── Cost map ──────────────────────────────────────────────────────────────────
CRATER_COST_WEIGHT=0.8
CRATER_BUFFER_RADIUS_PX=2

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
